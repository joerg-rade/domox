# PetShop sample ontology — the local fixture for RdfPort / JenaRdfAdapter and for the D3
# ontology diagram (see RdfGraphDiagrams).  Small on purpose: it covers classes with a
# sub-class hierarchy, object and datatype properties, and individuals with labels, so a
# CONSTRUCT over it produces a graph with all three node kinds.
#
#   val graph = rdfPort.load("petshop-ontology.ttl")
#   val graph = rdfPort.construct("petshop-ontology.ttl", "CONSTRUCT { ?s ?p ?o } WHERE { ?s ?p ?o }")

@prefix ps:   <http://example.org/petshop#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# --- classes -----------------------------------------------------------------

ps:Pet     a owl:Class ; rdfs:label "Pet" .
ps:Dog     a owl:Class ; rdfs:subClassOf ps:Pet ; rdfs:label "Dog" .
ps:Cat     a owl:Class ; rdfs:subClassOf ps:Pet ; rdfs:label "Cat" .
ps:Owner   a owl:Class ; rdfs:label "Owner" .
ps:Shop    a owl:Class ; rdfs:label "Shop" .
ps:Product a owl:Class ; rdfs:label "Product" .
ps:Sale    a owl:Class ; rdfs:label "Sale" .

# --- properties --------------------------------------------------------------

ps:isVaccinated a owl:DatatypeProperty ;
    rdfs:domain ps:Pet ; rdfs:range xsd:boolean ; rdfs:label "is vaccinated" .

ps:age a owl:DatatypeProperty ;
    rdfs:domain ps:Pet ; rdfs:range xsd:integer ; rdfs:label "age" .

ps:price a owl:DatatypeProperty ;
    rdfs:domain ps:Product ; rdfs:range xsd:decimal ; rdfs:label "price" .

ps:owns a owl:ObjectProperty ;
    rdfs:domain ps:Owner ; rdfs:range ps:Pet ; rdfs:label "owns" .

ps:sells a owl:ObjectProperty ;
    rdfs:domain ps:Shop ; rdfs:range ps:Product ; rdfs:label "sells" .

ps:includes a owl:ObjectProperty ;
    rdfs:domain ps:Sale ; rdfs:range ps:Product ; rdfs:label "includes" .

# --- individuals -------------------------------------------------------------

ps:Buddy a ps:Dog ;
    rdfs:label "Buddy the Golden Retriever" ;
    ps:isVaccinated true ;
    ps:age 3 .

ps:Whiskers a ps:Cat ;
    rdfs:label "Whiskers the Siamese" ;
    ps:isVaccinated false ;
    ps:age 5 .

ps:Alice a ps:Owner ;
    rdfs:label "Alice" ;
    ps:owns ps:Buddy , ps:Whiskers .

ps:PetShop a ps:Shop ;
    rdfs:label "The Pet Shop" ;
    ps:sells ps:DogFood , ps:CatToy .

ps:DogFood a ps:Product ; rdfs:label "Dry Dog Food" ; ps:price 24.90 .
ps:CatToy  a ps:Product ; rdfs:label "Feather Cat Toy" ; ps:price 6.50 .

ps:Sale4711 a ps:Sale ;
    rdfs:label "Sale 4711" ;
    ps:includes ps:DogFood .
