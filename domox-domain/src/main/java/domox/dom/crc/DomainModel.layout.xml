<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<bs:grid
        xmlns:bs="https://causeway.apache.org/applib/layout/grid/bootstrap3"
        xmlns:cpt="https://causeway.apache.org/applib/layout/component">

    <!-- Top Header & Unassigned Actions -->
    <bs:row>
        <bs:col span="12" unreferencedActions="true">
            <cpt:domainObject/>
        </bs:col>
    </bs:row>

    <!-- Main Content Split -->
    <bs:row>
        <!-- Left Side (1/3): Candidate collections in tabs, sorted by evidence strength. -->
        <bs:col span="4">
            <bs:tabGroup unreferencedCollections="true">
                <bs:tab name="Classes">
                    <bs:row>
                        <bs:col span="12">
                            <cpt:collection id="classList"/>
                        </bs:col>
                    </bs:row>
                </bs:tab>
                <bs:tab name="Actions">
                    <bs:row>
                        <bs:col span="12">
                            <cpt:collection id="actionList"/>
                        </bs:col>
                    </bs:row>
                </bs:tab>
                <bs:tab name="Properties">
                    <bs:row>
                        <bs:col span="12">
                            <cpt:collection id="propertyList"/>
                        </bs:col>
                    </bs:row>
                </bs:tab>
                <bs:tab name="Associations">
                    <bs:row>
                        <bs:col span="12">
                            <cpt:collection id="associationList"/>
                        </bs:col>
                    </bs:row>
                </bs:tab>
            </bs:tabGroup>
        </bs:col>

        <!-- Right Side (2/3): General Properties + Dependency Diagram, stacked vertically. -->
        <bs:col span="8">
            <bs:row>
                <bs:col span="12">
                    <cpt:fieldSet name="General" id="general" unreferencedProperties="true">
                    </cpt:fieldSet>
                </bs:col>
            </bs:row>
            <bs:row>
                <bs:col span="12">
                    <cpt:fieldSet name="Dependency Diagram" id="content">
                        <cpt:property id="hopDepth"/>
                        <cpt:property id="diagram"/>
                    </cpt:fieldSet>
                </bs:col>
            </bs:row>
        </bs:col>
    </bs:row>
</bs:grid>