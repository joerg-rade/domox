digraph LexicalDependencyGraph {
    // Layout and style settings for maximum compactness
    graph [
layout = neato
overlap = false
sep = "+10"
];

node [
shape = box
style = "rounded,filled"
fillcolor = "#F8F9FA"
color = "#333333"
fontname = "Helvetica"
fontsize = 10
height = 0.25
margin = "0.08,0.04"
];

edge [
fontname = "Helvetica"
fontsize = 8
color = "#555555"
arrowsize = 0.7
];

