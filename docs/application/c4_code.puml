@startuml
skinparam ClassBorderColor DarkRed
skinparam ClassBorderThickness 2
skinparam ClassBackgroundColor LightYellow

package "req" {
    class Author #lightyellow {
        firstName:String
        lastName:String
        eMail:String
    }
    class Document #lightgreen{
        id: Long
        title: String
        version: SemVer
        url:String
        created:TimeStamp
        imported:TimeStamp
        content: LOB
    }
    Document "1..n" -up- "1..n" Author
}

package nlp {
    class Sentence #lightgreen{
        id:Long
        raw: String
        parsed: ParseTree
    }

    enum PartOfSpeechType #lightblue {
        NOUN_PHRASE
        VERB_PHRASE
        VERB
        ADVP
        PP
        ...
    }

    enum TDType #lightblue {
        nsubj
        nsubjpass
        dobj
        iobj
        pobj
        nmod_of
        nmod_in
        nmod_to
        nmod_for
        nmod_from
        nmod_as
        nmod_by
        nmod_agent
        nmod_with
        nmod_poss
        amod
        compound
        conj_and
        conj_or
        nummod
        det
        xcomp
        neg
        advcl_if
        mark
        advmod_then
        advmod_else
    }

    class TypedDependency #pink {
        id: Long
        governor: String
        governorIndex: Integer
        governorGloss: String
        governorPos: PartOfSpeechType
        governorLemma: String
        dependent: String
        dependentIndex: Integer
        dependentGloss: String
        dependentPos: PartOfSpeechType
        dependentLemma: String
    }
    Sentence *- TypedDependency

    TypedDependency -up-> TDType : type
    TypedDependency -up-> PartOfSpeechType : pos

}

package type_system {
    enum RelationType #lightblue {
        ASSOCIATION
        AGGREGATION
        GENERALIZATION
        ATTRIBUTE
        BEHAVIOUR
    }

    abstract class Candidate {
        name: String
    }
    class ClassCdd extends Candidate {}
    class PropertyCdd extends Candidate {
        type: Type
    }
    class ActionCdd extends Candidate {
        inputTypes: List<Type>
        outputType: Type
    }
    class AssociationCdd extends Candidate {
        sourceCardinality: Integer
        targetCardinality: Integer
    }
    ClassCdd -up-> "0..n" PropertyCdd : properties
    ClassCdd -> "0..n" ActionCdd : actions
    ClassCdd "2" -up-> "0..n" AssociationCdd : associations

}

package rule {
    class RuleMatch #pink {
        id: Long
        ruleName: String
        matchedSentence: Sentence
        matchedTypedDependency: TypedDependency
        matchedCandidate: Candidate
    }
    RuleMatch -up-> "1" TypedDependency

    abstract class TypedDependencyRule #lightblue {
        name: String
        description: String
        when: TypedDependency -> Boolean
        then: TypedDependency -> RuleMatch
    }
    class "TDR1 .. TDR37" as TDR #lightblue {
    }
    TDR -|> TypedDependencyRule
    RuleMatch -up-> TDR
}
Sentence -> Document : content

class Analysis {
    id: Long
    started: TimeStamp
    ended: TimeStamp
    processRequrements()
    constructDomainModel()
}
class DomainModel {
    generatePlantUml()
}

DomainModel *-> "1..n" ClassCdd

Analysis -> "1..n" Document : input
Analysis -up-> "0..n" RuleMatch
Analysis -> DomainModel : output

@enduml

        A1 .. A4
        B1 .. B5
        C1 .. C4
        D1 .. D4
        N1 .. N3


        acl
        case
        cc
        csubj
        csubjpass
        punct
        root
        xsubj
