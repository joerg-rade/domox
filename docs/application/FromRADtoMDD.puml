@startuml

cloud "Model" as M #57B1BB {
    (Domain\nModel) as DOM #FFFFFF
    note top of DOM #FFFFFF
    {{
        abstract Component
        class Leaf
        class Composite
        Component <|-down- Leaf
        Component <|-down- Composite
        Composite *-up- Component
    }}
    end note
}

actor "Stakeholder\n/ Designer" as User #7A2036ff

together {
    :User: -up-> DOM : analyze Domain and\n (1) create (first iteration) or\n (1+) refine (subsequent iterations)
}

(User\nInterface) as UI #6BBAC6
DOM -right-> UI : Apache\nCauseway\ngenerates

note top of UI #FED017
--Apache Causeway Application--
{{
salt
{#
{* File | Edit | Source | Refactor }
{/ <b>General | Fullscreen | Behavior | Saving }
Name " "
Modifiers: (X) public () default () private () protected
[] abstract [] final [] static
Superclass: { "java.lang.Object " | [Browse...] }
}
}}
end note

UI --> User : interact\nwith UI

@enduml

' Causeway colors
' $pacific-blue: #6BBAC6ff;
  '$dark-amaranth: #7A2036ff;
  '$bright-amber: #FED017ff;
  '$pacific-blue-2: #57B1BBff;
  '$dark-amaranth-2: #75172Ef