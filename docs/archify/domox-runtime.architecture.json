  "cards": [
    {
      "dot": "cyan",
      "title": "TDR Rulebook · Phase 1",
      "items": [
        "40 rules (TDR1–40) scan Stanford typed dependencies of each sentence",
        "RuleMatches.create() persists one RuleMatch per candidate hit",
        "Guard: blocked use-case nouns (e.g. \"Actor\") return null, never persisted"
      ]
    },
    {
      "dot": "violet",
      "title": "Candidate freezing · Phase 2",
      "items": [
        "createCandidatesFrom maps RuleMatch → ClassCdd / PropertyCdd / ActionCdd / AssociationCdd",
        "Coad (1999) archetype classifier suggests a ClassType (e.g. Role, Moment-Interval)",
        "CandidateResolver late-binds ambiguous nouns (Option C)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Human-in-the-loop gate",
      "items": [
        "Review + ReviewRationale attach to each Candidate",
        "ReviewStatus decides inclusion in the DomainModel",
        "Only approved candidates reach code and UML generation"
      ]
    },
    {
      "dot": "rose",
      "title": "External services & trust",
      "items": [
        "Stanford CoreNLP (Docker) — REST NL text crosses into the runtime",
        "PostgreSQL (Docker) — all entities persisted via Causeway/JPA",
        "Kroki (Docker) — renders PlantUML to SVG/PNG for review"
      ]
    },
    {
      "dot": "amber",
      "title": "Code & UML generation",
      "items": [
        "JavaCode.kt emits JPA/Causeway entity skeletons with Lombok",
        "ClassDiagram + PumlCode emit PlantUML class diagrams",
        "Generated code stays traceable to the DomainModel and requirements"
      ]
    }
  ]
}
