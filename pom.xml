        <result.version>3.1.0</result.version>
        <resteasy-core.version>7.0.0.Final</resteasy-core.version>
        <!-- Apache Tomcat (transitive via spring-boot-starter-tomcat in domox-webapp).
             CVE-2025-24813 (critical RCE / path traversal) affects 10.1.0-M1..10.1.34;
             fixed in 10.1.35. 10.1.53 keeps tomcat-embed-core in step with the other embed
             artifacts (websocket / el) that the Spring Boot BOM already resolves to 10.1.53. -->
        <tomcat-embed-core.version>10.1.53</tomcat-embed-core.version>
        <!-- Apache Log4j 2.x (transitive, active logging backend via
             spring-boot-starter-log4j2 -> log4j-slf4j2-impl). CVE-2026-34480 (XmlLayout
             fails to strip XML-1.0-forbidden chars) affects log4j-core up to 2.25.3,
             fixed in 2.26.0; CVE-2026-49844 (MapMessage.asJson() non-finite floats)
             affects log4j-api up to 2.26.0, fixed in 2.26.1. -->
        <log4j2.version>2.26.1</log4j2.version>
        <!-- Jackson aligned at the latest 2.21.x patch. The Boot 3.5.x BOM pulls 2.21.2
             (databind carries CVE-2026-54512/54513 PolymorphicTypeValidator + JsonView
             bypasses, fixed in 2.21.3); the root previously pinned jackson-core to 2.18.6,
             exposing the older core line. Managing jackson-bom at 2.21.7 keeps core/databind
             at 2.21.7 with jackson-annotations (which dropped patch releases at 2.20) at 2.21. -->
        <jackson.version>2.21.7</jackson.version>
        <!-- jackson-annotations dropped patch releases at 2.20 (its 2.21 line is version
             "2.21" only); jackson-core/databind keep full patch versions. -->
        <jackson-annotations.version>2.21</jackson-annotations.version>
        <spring-data.version>3.5.13</spring-data.version>
        <jsoup.version>1.23.2</jsoup.version>
        <logback.version>1.5.38</logback.version>
