# Compiled class file
*.class

# Log file
*.log

# Persistent app log directory (log4j2 RollingFile appender, default ./logs)
logs/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# IDE files
**/.idea/

# build artefacts
/domox-domain/target/
/domox-webapp/target/
/domox-webapp/target/classes/*.yml
# State file for scripts/check-schema-drift.sh: the schema-projection hash of the entity sources at
# the point the checked-in create-tables.sql was last known current (see scripts/schema-projection.py).
/domox-webapp/create-tables.sql.projection
/domox-service/target/
/domox-service/domox-service.iml
/target/
/domox-adapter/target/

# Python caches (scripts/*.py)
__pycache__/
*.pyc

# Local database backups (scripts/db-backup.sh) — binary analysis snapshots, not source
/backups/

